// Worker del momentum. Pubblicazione: Workers Builds collegato al repository (cartella workers/momentum),
// oppure "npx wrangler deploy" da questa cartella. Nessuna chiave: SportScore non ne richiede.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fischietto-momentum",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  // Ogni minuto. Il piano gratuito permette 5 cron per account: questo ne usa uno.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fischietto-momentum",
      "database_id": "a1dc5603-905b-4a16-bccb-60a0cfc00bb7"
    }
  ],
  // Niente blocco "limits": il piano gratuito lo rifiuta (errore 100328) e applica già da sé
  // 50 richieste esterne e 10 ms di CPU. src/collect.js resta sotto: al massimo 48 richieste (REQUEST_LIMIT).
  // Avvisi via email (src/alerts.js) agli indirizzi verificati in Email Routing: gratuito. Il destinatario
  // è il secret ALERT_TO, impostato dalla dashboard del Worker, quindi non compare nel repository.
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
