# Copia questo file in .env e inserisci le tue chiavi localmente.
# NON inserire mai valori reali qui e non committare .env.
# Senza chiavi l'app parte in modalità demo con dati inventati.

# Dati reali: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Provider AI (facoltativi); usa solo chiavi personali e con limiti di spesa.
GROQ_API_KEY=
GEMINI_API_KEY=

# Ricerca notizie gratuita quando Groq è fuori quota (facoltative)
# TAVILY_API_KEY: 1.000 ricerche al mese gratis su tavily.com
# SEARXNG_URL: indirizzo di un SearXNG con formato JSON attivo (nel workflow: http://localhost:8080)
TAVILY_API_KEY=
SEARXNG_URL=

# Configurazione facoltativa
COMPETITION=SA
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
