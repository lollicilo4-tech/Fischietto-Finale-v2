# Copia questo file in .env e inserisci le tue chiavi.
# Senza chiavi l'app parte in modalità demo con dati inventati.

# Dati reali del campionato: registrazione gratuita su https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Analisi AI gratuita con ricerca web tramite Groq + GPT-OSS
GROQ_API_KEY=

# Facoltativi
COMPETITION=SA
GROQ_MODEL=openai/gpt-oss-20b
