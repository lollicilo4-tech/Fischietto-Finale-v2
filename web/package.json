{
  "name": "fischietto-finale-web",
  "private": true,
  "type": "module",
  "description": "Sito di Fischietto finale in Astro: pagine statiche generate dai JSON in docs/ e isole interattive in JavaScript puro.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm test && npm run build && npm run check:dist",
    "import:css": "node scripts/import-legacy-css.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "7.4.2",
    "satori": "0.63.2"
  },
  "overrides": {
    "fflate": "0.8.3"
  }
}
