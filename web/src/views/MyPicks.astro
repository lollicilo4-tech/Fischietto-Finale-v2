---
/* I miei pronostici: la sfida con il modello. Tutto nel browser (scripts/mypage.js): la pagina statica
   ha solo la spiegazione e il contenitore. */
import Base from "../layouts/Base.astro";
import { myPicksUrl } from "../lib/core.js";
import { setLang, langOfPath, t } from "../lib/i18n.js";
setLang(langOfPath(Astro.url.pathname));
---
<Base title={t("I miei pronostici")} description={t("Scegli 1, X o 2 prima del calcio d'inizio e sfida il modello di Fischietto finale: quante ne azzecchi tu e quante il modello. Niente soldi né quote, tutto resta sul tuo telefono.")} section={undefined} path={myPicksUrl()}>
  <section id="p-mypicks" aria-labelledby="my-title">
    <h2 class="sub2" id="my-title">{t("I miei pronostici")}</h2>
    <p class="lead">{t("Nella scheda di ogni partita puoi scegliere 1, X o 2 fino al calcio d'inizio. Qui vedi quante ne azzecchi rispetto al modello. È una sfida, non una scommessa: niente soldi e niente quote. I pronostici restano solo su questo dispositivo, senza account.")}</p>
    <div id="my-picks"><div class="msg">{t("Caricamento dei tuoi pronostici…")}</div></div>
    <noscript><div class="msg">{t("Per vedere i tuoi pronostici serve JavaScript.")}</div></noscript>
  </section>
  <script>
    import "../scripts/mypage.js";
  </script>
</Base>
