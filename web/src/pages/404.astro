---
import Base from "../layouts/Base.astro";
import { LEAGUES, leagueUrl } from "../lib/core.js";
---
<Base title="Pagina non trovata" description="La pagina cercata non esiste più: le partite restano online finché sono nel turno pubblicato." section={undefined} path="/404/" noindex>
  <section aria-labelledby="nf-title">
    <h2 class="sub2" id="nf-title">Pagina non trovata</h2>
    <p class="lead">Forse la partita è già stata giocata: le pagine delle partite restano online finché sono nel turno pubblicato. Il risultato e il pronostico fatto prima sono nello Storico.</p>
    <div class="panel"><ul>{LEAGUES.map((l) => <li><a href={leagueUrl(l.code, "partite")}>Partite di {l.name}</a> · <a href={leagueUrl(l.code, "storico")}>Storico</a></li>)}</ul></div>
  </section>
</Base>
