// Configurazione del progetto Cloudflare Pages "fischietto-finale-v2" (cartella web/).
// Quando questo file esiste, Pages lo usa al posto delle impostazioni della dashboard per i binding.
// Il sito resta statico (dist/); l'unica funzione è /api/momentum (functions/api/momentum.js), che legge
// il database D1 scritto dal Worker in workers/momentum.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fischietto-finale-v2",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fischietto-momentum",
      "database_id": "a1dc5603-905b-4a16-bccb-60a0cfc00bb7"
    }
  ]
}
